<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer (Android 12+): everything except downloaded voice models,
     which are large and can be downloaded again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="voices/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="voices/" />
    </device-transfer>
</data-extraction-rules>
